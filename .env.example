# ===== Gemini AI（圖檔辨識題目、拍照改考卷、批改簡答題）=====
# 前往 https://aistudio.google.com → Get API key（取得 API 金鑰）免費申請
GEMINI_API_KEY=

# 可選：指定模型，預設 gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# ===== 資料庫設定（多模式自動判斷）=====
# 1. 留空：使用本機 SQLite 檔案（data/school.db，免安裝、最簡單）
# 2. Supabase（PostgreSQL）：填入 Supabase 連線字串，例如：
#    DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
#    或
#    DATABASE_URL=postgresql://postgres:your_password@db.xxxx.supabase.co:5432/postgres
# 3. Turso（libSQL）：填入 Turso 網址與 DATABASE_AUTH_TOKEN
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# 網站埠號（預設 3000）
PORT=3000
